# Salin menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.

# --- AI (Google Gemini). Tanpa USE_LLM=true aplikasi memakai mode simulasi ---
USE_LLM=true
GEMINI_API_KEY=isi-di-.env.local-atau-Vercel-jangan-di-commit
GEMINI_MODEL=gemini-3.7-flash

# --- Database (MongoDB). Kosongkan MONGODB_URI untuk memakai file JSON lokal ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=digitani

AUTH_SECRET=ganti-dengan-string-acak-panjang
