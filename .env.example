# Salin menjadi .env.local (lokal) atau isi di Vercel > Settings > Environment Variables.
# AI bersifat opsional. Tanpa USE_LLM=true, aplikasi memakai mode simulasi.
USE_LLM=true
GEMINI_API_KEY=isi-di-.env.local-atau-Vercel-jangan-di-commit
GEMINI_MODEL=gemini-3.7-flash
AUTH_SECRET=ganti-dengan-string-acak-panjang
